# Normalize line endings: LF in the repo, LF in the working tree everywhere.
# Without this, Windows checkouts (core.autocrlf=true) produce CRLF working
# copies and Biome's format check fails on Linux CI.
* text=auto eol=lf

# Explicitly binary — never munge these.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.wasm binary

# Generated / vendored: collapse in diffs and exclude from language stats.
pnpm-lock.yaml linguist-generated=true -diff
