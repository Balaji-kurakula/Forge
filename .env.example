# Forge local dev — substrate store connection strings.
# Copy to .env and adjust. Used by docker-compose.yml and (later) the real
# SubstrateClient. The in-memory client (pnpm demo / tests) needs none of these.

# ── Code Graph — Neo4j ──────────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=forge-dev-neo4j
# docker-compose reads this to set the initial password (user is always neo4j):
NEO4J_AUTH=neo4j/forge-dev-neo4j

# ── Behavioral Graph — TimescaleDB (Postgres wire protocol) ─────────────────────
TIMESCALE_URL=postgres://forge:forge-dev-ts@localhost:5433/forge_behavior

# ── Decision + Team Graph — Postgres + pgvector ─────────────────────────────────
PGVECTOR_URL=postgres://forge:forge-dev-pg@localhost:5432/forge_decision

# ── Default tenant for local seeds ──────────────────────────────────────────────
FORGE_TENANT=acme
